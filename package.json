{
  "name": "openloops",
  "version": "0.1.16",
  "description": "Framework to build AI Agents",
  "author": {
    "name": "Jose Barcos",
    "email": "jose@openloops.xyz",
    "url": "https://github.com/jbarcosdev"
  },
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/services/agent/core/index.d.ts",
      "default": "./dist/services/agent/core/index.js"
    },
    "./skills": {
      "types": "./dist/services/agent/skills/index.d.ts",
      "default": "./dist/services/agent/skills/index.js"
    },
    "./tools": {
      "types": "./dist/services/agent/tools/index.d.ts",
      "default": "./dist/services/agent/tools/index.js"
    },
    "./loops": {
      "types": "./dist/services/agent/loops/index.d.ts",
      "default": "./dist/services/agent/loops/index.js"
    },
    "./app": {
      "types": "./dist/services/app/core/index.d.ts",
      "default": "./dist/services/app/core/index.js"
    },
    "./chats": {
      "types": "./dist/services/agent/modules/chats/index.d.ts",
      "default": "./dist/services/agent/modules/chats/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc-alias",
    "prepublishOnly": "yarn build",
    "check-size": "npm pack --dry-run",
    "release": "npm version patch && npm publish --access public"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "^0.73.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sentry/node": "^10.29.0",
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "countries-and-currencies-utils": "^0.1.9",
    "cryptr": "^6.4.0",
    "dotenv": "^18.0.3",
    "html-to-text": "^10.0.0",
    "jsonwebtoken": "^9.0.3",
    "langfuse": "^3.38.20",
    "mongodb": "^6.18.0",
    "openai": "^6.10.0",
    "p-limit": "^7.2.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "sanitize-html": "^2.17.0",
    "source-map-support": "^0.5.21",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/sanitize-html": "^2.16.0",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "eslint": "^9.39.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.2.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^7.2.1",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "ts-jest": "^29.4.6",
    "tsc-alias": "^1.9.5",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
