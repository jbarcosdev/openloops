{
  "name": "openloops",
  "version": "0.9.0",
  "description": "Open source harness for building multitenant AI agents for your SaaS: a TypeScript runtime with persistence, tools, MCP trust, approvals and autonomous automations",
  "author": {
    "name": "Jose Barcos",
    "email": "jose@openloops.xyz",
    "url": "https://github.com/jbarcosdev"
  },
  "license": "Apache-2.0",
  "homepage": "https://openloops.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbarcosdev/openloops.git"
  },
  "bugs": {
    "url": "https://github.com/jbarcosdev/openloops/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./base": {
      "types": "./dist/common/base/index.d.ts",
      "default": "./dist/common/base/index.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "default": "./dist/common/index.js"
    },
    "./core": {
      "types": "./dist/harness/index.d.ts",
      "default": "./dist/harness/index.js"
    },
    "./clients": {
      "types": "./dist/clients/index.d.ts",
      "default": "./dist/clients/index.js"
    },
    "./skills": {
      "types": "./dist/skills/index.d.ts",
      "default": "./dist/skills/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.js"
    },
    "./loops": {
      "types": "./dist/loops/index.d.ts",
      "default": "./dist/loops/index.js"
    },
    "./guardrails": {
      "types": "./dist/guardrails/index.d.ts",
      "default": "./dist/guardrails/index.js"
    },
    "./authentication": {
      "types": "./dist/services/authentication/index.d.ts",
      "default": "./dist/services/authentication/index.js"
    },
    "./chats": {
      "types": "./dist/services/chats/index.d.ts",
      "default": "./dist/services/chats/index.js"
    },
    "./llmcalls": {
      "types": "./dist/services/llmcalls/index.d.ts",
      "default": "./dist/services/llmcalls/index.js"
    },
    "./mcps": {
      "types": "./dist/services/mcp-servers/index.d.ts",
      "default": "./dist/services/mcp-servers/index.js"
    },
    "./mcps/admin": {
      "types": "./dist/services/mcp-servers/admin/index.d.ts",
      "default": "./dist/services/mcp-servers/admin/index.js"
    },
    "./automations": {
      "types": "./dist/services/automations/index.d.ts",
      "default": "./dist/services/automations/index.js"
    },
    "./users": {
      "types": "./dist/services/users/index.d.ts",
      "default": "./dist/services/users/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && tsc-alias",
    "prepublishOnly": "yarn build",
    "check-size": "npm pack --dry-run",
    "release": "npm version patch && npm publish --access public",
    "push": "git push --follow-tags",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migrate:automations": "ts-node scripts/migrate-automations.ts",
    "migrate:chat-titles": "ts-node scripts/migrate-chat-titles.ts",
    "eval": "ts-node --project evals/tsconfig.json evals/run.ts",
    "eval:models": "ts-node --project evals/tsconfig.json evals/run.ts models",
    "eval:skills": "ts-node --project evals/tsconfig.json evals/run.ts skills",
    "eval:compare": "ts-node --project evals/tsconfig.json evals/run.ts compare",
    "eval:bundle": "ts-node --project evals/tsconfig.json evals/run.ts bundle",
    "eval:report": "ts-node --project evals/tsconfig.json evals/run.ts report",
    "eval:show": "ts-node --project evals/tsconfig.json evals/run.ts show",
    "eval:list": "ts-node --project evals/tsconfig.json evals/run.ts list"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "bcryptjs": "^3.0.3",
    "croner": "^11.0.0",
    "cryptr": "^6.4.0",
    "dotenv": "^18.0.9",
    "iso-data": "^0.1.0",
    "jsonwebtoken": "^9.0.3",
    "langfuse": "^3.39.2",
    "mongodb": "^7.8.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@sentry/node": "^11.11.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "ts-jest": "^29.4.15",
    "tsc-alias": "^1.9.10",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@sentry/node": "^11.11.0"
  },
  "peerDependenciesMeta": {
    "@sentry/node": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "ai-agent",
    "ai-agents",
    "agent-harness",
    "agent-framework",
    "agent-runtime",
    "agent-loop",
    "multitenant",
    "saas",
    "agentic",
    "autonomous-agents",
    "llm",
    "mcp",
    "model-context-protocol",
    "tool-calling",
    "function-calling",
    "human-in-the-loop",
    "guardrails",
    "typescript",
    "nodejs",
    "mongodb",
    "langchain-alternative",
    "langgraph-alternative"
  ]
}
