# Environment
IS_LOCAL=true
NODE_ENV=development

OPENLOOPS_DB_URI="mongodb://localhost:27017/"
OPENLOOPS_DB_NAME='openloops'

SECRET_MANAGER_KEY=secret

# Default model provider (anthropic, claude-haiku-5-5)
ANTHROPIC_API_KEY=

# Other providers, only if you choose them per chat
OPENAI_API_KEY=
GEMINI_API_KEY=

# Authentication (login)
JWT_SECRET=

# Model used when nothing else chooses one, optional, set both or neither
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

# Agentic jobs, optional, in milliseconds (default 60000 and 600000)
AGENTIC_JOBS_POLL_INTERVAL_MS=
AGENTIC_JOBS_LEASE_MS=

# Timeouts in milliseconds, optional (default 60000)
LLM_CALL_TIMEOUT_MS=
MCP_TOOL_TIMEOUT_MS=

# Sentry
SENTRY_DSN=

# Langfuse
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# Serper
SERPER_API_KEY=

# Slack
SLACK_BOT_TOKEN=
